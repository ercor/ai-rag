# =============================================================================
# ai-rag — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for docker compose usage.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (asyncpg driver).
# Default matches docker-compose.yml credentials.
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# -----------------------------------------------------------------------------
# Ollama (LLM & Embeddings)
# -----------------------------------------------------------------------------
# Ollama API base URL. Use http://ollama:11434 inside docker compose,
# or http://localhost:11434 for local development.
OLLAMA_BASE_URL=http://ollama:11434

# Generation model. Must be pulled in Ollama before first query.
# Recommended: qwen2.5 (7B) or qwen2.5:3b for limited resources.
OLLAMA_MODEL=qwen2.5

# Embedding model. Must produce 768-dimensional vectors.
# Recommended: nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
# Directory to scan for documents. Inside docker compose, this is /app/data/docs.
# For local development, use ./data/docs.
WATCH_DIR=./data/docs

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Maximum number of chunks to pass to the generator after RRF fusion.
RETRIEVAL_TOP_K=5

# Minimum RRF score required to generate an answer.
# Set to 0.0 to disable score-based abstention (any retrieved chunk is enough).
MIN_SCORE_THRESHOLD=0.0

# -----------------------------------------------------------------------------
# Adapter Selectors
# -----------------------------------------------------------------------------
# Which adapter implementation to use for each port.
# Currently only "ollama" is supported for embedder and generator.
EMBEDDER_ADAPTER=ollama
GENERATOR_ADAPTER=ollama

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
# Default allows the Next.js dev server.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# API URL used by the Next.js frontend to reach the backend.
# Inside docker compose: http://backend:8000
# For local frontend dev: http://localhost:8000
NEXT_PUBLIC_API_URL=http://backend:8000

# -----------------------------------------------------------------------------
# Embedding Batch Configuration
# -----------------------------------------------------------------------------
# Number of texts to embed in a single API call (CPU mode).
# Default: 64. Increase for better throughput if memory allows.
EMBED_BATCH_SIZE=64

# Number of texts to embed in a single API call (GPU mode).
# Default: 256. Larger batches leverage GPU parallelism.
# Only used when GPU is detected or GPU_ENABLED=true.
EMBED_BATCH_SIZE_GPU=256

# -----------------------------------------------------------------------------
# GPU Acceleration
# -----------------------------------------------------------------------------
# Enable GPU acceleration for embedding and generation.
# Set to true to force GPU mode, or leave false for auto-detection.
# Auto-detection checks for NVIDIA GPU via nvidia-smi.
# Requires Ollama to be configured with GPU support.
GPU_ENABLED=false

# -----------------------------------------------------------------------------
# Ingestion Concurrency
# -----------------------------------------------------------------------------
# Maximum number of documents to process in parallel during ingestion.
# Default: 2. Increase for faster ingestion if resources allow.
INGEST_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Cross-Encoder Reranking
# -----------------------------------------------------------------------------
# Enable cross-encoder reranking after RRF fusion.
# When enabled, the pipeline fetches RERANKER_TOP_K_BEFORE candidates from RRF,
# re-scores them with a cross-encoder model, and keeps RERANKER_TOP_K_AFTER.
RERANKER_ENABLED=true

# Cross-encoder model name (HuggingFace model ID).
# Default: cross-encoder/ms-marco-MiniLM-L-6-v2 (~80MB, fast on CPU).
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of candidates to fetch from RRF before reranking.
RERANKER_TOP_K_BEFORE=20

# Number of candidates to keep after reranking.
RERANKER_TOP_K_AFTER=5

# Timeout in seconds for the reranking step.
# If exceeded, the pipeline falls back to non-reranked RRF results.
RERANKER_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# Query Rewriting
# -----------------------------------------------------------------------------
# Enable multi-query expansion via LLM.
# When enabled, the pipeline generates QUERY_REWRITER_NUM_VARIANTS query variants,
# searches for each in parallel, and merges results via cross-variant RRF.
# Disabled by default due to added latency (~1-2s overhead).
QUERY_REWRITER_ENABLED=false

# Total number of query variants to produce (including the original).
# Default: 3 (original + 2 rephrasings).
QUERY_REWRITER_NUM_VARIANTS=3
